  "role_requirements": {
    "orchestrator": {
      "description": "Coordinates tasks, routes to workers, interacts with user",
      "priority_strengths": ["reasoning", "instruction following", "large context"],
      "minimum_quality_tier": "medium",
      "speed_preference": "fast",
      "notes": "Needs good reasoning to route tasks correctly. Speed matters for UX."
    },
    "worker-heavy": {
      "description": "Complex code generation, refactoring, large changes",
      "priority_strengths": ["code generation", "large context", "refactoring"],
      "minimum_quality_tier": "high",
      "speed_preference": "any",
      "notes": "Quality is paramount. Can be slower."
    },
    "worker-lite": {
      "description": "Simple tasks: search, format, lint, quick queries",
      "priority_strengths": ["fast", "code completion"],
      "minimum_quality_tier": "low",
      "speed_preference": "fast",
      "notes": "Speed is paramount. Simple tasks only."
    },
    "validator": {
      "description": "Independent verification of plans and claims",
      "priority_strengths": ["reasoning", "verification", "chain-of-thought"],
      "minimum_quality_tier": "medium",
      "speed_preference": "medium",
      "notes": "Needs skeptical reasoning to catch errors."
    },
    "critic": {
      "description": "Quality gate - runs tests, checks coverage, reviews code",
      "priority_strengths": ["reasoning", "quality assessment"],
      "minimum_quality_tier": "medium",
      "speed_preference": "medium",
      "notes": "Must accurately assess quality before commit."
    }

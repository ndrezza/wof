# WOI Git Attributes - Normalize line endings to LF
# This prevents "LF will be replaced by CRLF" warnings
# Installed by WOF (Workload Orchestration Framework)

# Auto detect text files and normalize to LF in repo
* text=auto eol=lf

# Explicitly declare text files to ensure normalization
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf

# Templates
*.template text eol=lf

# Keep Windows batch files as CRLF (if any are added)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (don't touch)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary

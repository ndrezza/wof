{
  "$schema": "./ado.schema.json",
  "description": "Azure DevOps MCP configuration - preserved after WOF removal. Run /wof configure-ado to set up.",

  "connection": {
    "organizationUrl": "",
    "project": "",
    "pat": ""
  },

  "filters": {
    "valueArea": "",
    "workItemTypes": ["User Story", "Task", "Bug", "Feature"],
    "states": ["New", "Active", "Resolved"],
    "areaPath": "",
    "iterationPath": ""
  },

  "wiqlDefaults": {
    "maxResults": 50,
    "orderBy": "System.ChangedDate DESC"
  },

  "mcp": {
    "serverPackage": "@tiberriver256/mcp-server-azure-devops",
    "authMethod": "pat",
    "envVars": ["AZURE_DEVOPS_ORG_URL", "AZURE_DEVOPS_AUTH_METHOD", "AZURE_DEVOPS_PAT", "AZURE_DEVOPS_DEFAULT_PROJECT"]
  }
}

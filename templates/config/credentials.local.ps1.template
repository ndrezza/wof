# Azure AI Credentials Template
# Copy this file to credentials.local.ps1 and fill in your values
# credentials.local.ps1 is gitignored and will not be committed

# =============================================================================
# AZURE AI FOUNDRY (Anthropic Models - Worker, Validator)
# =============================================================================
# Endpoint format: https://<resource-name>.services.ai.azure.com/anthropic
$env:AZURE_ANTHROPIC_ENDPOINT = '{{AZURE_ANTHROPIC_ENDPOINT}}'
$env:AZURE_ANTHROPIC_API_KEY = 'your-api-key-here'

# Aliases for backwards compatibility
$env:ANTHROPIC_FOUNDRY_BASE_URL = $env:AZURE_ANTHROPIC_ENDPOINT
$env:ANTHROPIC_FOUNDRY_API_KEY = $env:AZURE_ANTHROPIC_API_KEY

# =============================================================================
# AZURE OPENAI (optional - for additional AI services)
# =============================================================================
# Endpoint format: https://<resource-name>.cognitiveservices.azure.com
$env:AZURE_OPENAI_ENDPOINT = '{{AZURE_OPENAI_ENDPOINT}}'
$env:AZURE_OPENAI_API_KEY = 'your-api-key-here'

# =============================================================================
# AZURE CODEX (Critic)
# =============================================================================
# Endpoint format: https://<resource-name>.cognitiveservices.azure.com/openai/responses
$env:AZURE_CODEX_ENDPOINT = '{{AZURE_CODEX_ENDPOINT}}'
$env:AZURE_CODEX_API_KEY = 'your-api-key-here'

# =============================================================================
# LOCAL WORKER (Worker-Lite)
# =============================================================================
# Endpoint for local model server (Ollama recommended, or vLLM/llama.cpp with proxy)
# Ollama: http://localhost:11434 (native Anthropic API support)
$env:LOCAL_WORKER_ENDPOINT = '{{LOCAL_WORKER_ENDPOINT}}'

# =============================================================================
# VERIFICATION
# =============================================================================
Write-Host "AI Credentials loaded:" -ForegroundColor Cyan
Write-Host "  Azure Anthropic: $(if($env:AZURE_ANTHROPIC_ENDPOINT){'Set'}else{'NOT SET'})" -ForegroundColor $(if($env:AZURE_ANTHROPIC_ENDPOINT){'Green'}else{'Red'})
Write-Host "  Azure OpenAI: $(if($env:AZURE_OPENAI_ENDPOINT){'Set'}else{'NOT SET'})" -ForegroundColor $(if($env:AZURE_OPENAI_ENDPOINT){'Green'}else{'Red'})
Write-Host "  Azure Codex: $(if($env:AZURE_CODEX_ENDPOINT){'Set'}else{'NOT SET'})" -ForegroundColor $(if($env:AZURE_CODEX_ENDPOINT){'Green'}else{'Red'})
Write-Host "  Local Worker: $(if($env:LOCAL_WORKER_ENDPOINT){'Set'}else{'NOT SET'})" -ForegroundColor $(if($env:LOCAL_WORKER_ENDPOINT){'Green'}else{'Yellow'})

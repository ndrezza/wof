#Requires -Version 5.1
<#
.SYNOPSIS
    Starts Claude Code with Ollama backend (local LLM)

.DESCRIPTION
    Generated by WOF /wof configure
    Connects Claude Code to local Ollama instance for cost-free local inference.

.PARAMETER Model
    Override the default model. If not specified, uses {{DEFAULT_MODEL}}.

.PARAMETER Host
    Ollama host. Default: {{OLLAMA_HOST}}

.PARAMETER Port
    Ollama port. Default: {{OLLAMA_PORT}}

.EXAMPLE
    ./Start-ClaudeLocal.ps1
    Starts Claude Code with default Ollama model.

.EXAMPLE
    ./Start-ClaudeLocal.ps1 -Model "deepseek-r1:8b"
    Starts Claude Code with a specific model.

.NOTES
    Generated: {{GENERATED_DATE}}
    WOF Version: {{WOF_VERSION}}
#>

[CmdletBinding()]
param(
    [Parameter(Position = 0)]
    [string]$Model,

    [string]$Host = "{{OLLAMA_HOST}}",

    [int]$Port = {{OLLAMA_PORT}}
)

$ErrorActionPreference = "Stop"

# Configuration
$OllamaUrl = "http://${Host}:${Port}"
$DefaultModel = if ($Model) { $Model } else { "{{DEFAULT_MODEL}}" }

# Colors for output
function Write-Status { param([string]$Message) Write-Host "[*] $Message" -ForegroundColor Gray }
function Write-Success { param([string]$Message) Write-Host "[+] $Message" -ForegroundColor Green }
function Write-Error { param([string]$Message) Write-Host "[-] $Message" -ForegroundColor Red }
function Write-Warning { param([string]$Message) Write-Host "[!] $Message" -ForegroundColor Yellow }

# Banner
Write-Host ""
Write-Host "  Claude Code - Local Mode (Ollama)" -ForegroundColor Cyan
Write-Host "  ===================================" -ForegroundColor Cyan
Write-Host ""

# Step 1: Check Ollama is running
Write-Status "Checking Ollama at $OllamaUrl..."

try {
    $response = Invoke-RestMethod -Uri "$OllamaUrl/api/version" -TimeoutSec 5 -ErrorAction Stop
    $version = $response.version
    Write-Success "Ollama v$version is running"
} catch {
    Write-Error "Cannot connect to Ollama at $OllamaUrl"
    Write-Host ""
    Write-Host "  Make sure Ollama is running:" -ForegroundColor Yellow
    Write-Host "    ollama serve" -ForegroundColor White
    Write-Host ""
    Write-Host "  Or start the Ollama app if installed." -ForegroundColor Gray
    Write-Host ""
    exit 1
}

# Step 2: Check models are available
Write-Status "Checking available models..."

try {
    $tags = Invoke-RestMethod -Uri "$OllamaUrl/api/tags" -TimeoutSec 5 -ErrorAction Stop
    $modelCount = $tags.models.Count

    if ($modelCount -eq 0) {
        Write-Warning "No models found in Ollama"
        Write-Host ""
        Write-Host "  Pull a model first:" -ForegroundColor Yellow
        Write-Host "    ollama pull qwen3-coder:30b" -ForegroundColor White
        Write-Host ""
        exit 1
    }

    Write-Success "$modelCount model(s) available"
} catch {
    Write-Error "Failed to list Ollama models: $_"
    exit 1
}

# Step 3: Verify requested model exists
$modelExists = $tags.models | Where-Object { $_.name -eq $DefaultModel }

if (-not $modelExists) {
    Write-Warning "Model '$DefaultModel' not found in Ollama"
    Write-Host ""
    Write-Host "  Available models:" -ForegroundColor Yellow
    $tags.models | ForEach-Object {
        $size = [math]::Round($_.size / 1GB, 1)
        Write-Host "    - $($_.name) (${size}GB)" -ForegroundColor White
    }
    Write-Host ""
    Write-Host "  Pull the model:" -ForegroundColor Yellow
    Write-Host "    ollama pull $DefaultModel" -ForegroundColor White
    Write-Host ""
    exit 1
}

Write-Success "Model '$DefaultModel' is available"

# Step 4: Configure environment for Claude Code
Write-Status "Configuring Claude Code environment..."

$env:ANTHROPIC_BASE_URL = $OllamaUrl
$env:ANTHROPIC_API_KEY = "ollama"

Write-Success "Environment configured"

# Step 5: Display summary
Write-Host ""
Write-Host "  Configuration:" -ForegroundColor Cyan
Write-Host "    Backend:  $OllamaUrl" -ForegroundColor Gray
Write-Host "    Model:    $DefaultModel" -ForegroundColor Gray
Write-Host ""

# Step 6: Start Claude Code
Write-Status "Starting Claude Code..."
Write-Host ""

# Pass through any additional arguments
claude @args

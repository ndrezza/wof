#!/usr/bin/env bash
#
# Start Claude Code with Ollama backend (local LLM)
#
# Generated by WOF /wof configure
# Connects Claude Code to local Ollama instance for cost-free local inference.
#
# Usage:
#   ./start-claude-local.sh                    # Use default model
#   ./start-claude-local.sh --model <name>     # Use specific model
#   ./start-claude-local.sh --host 192.168.1.1 # Use remote Ollama
#
# Generated: {{GENERATED_DATE}}
# WOF Version: {{WOF_VERSION}}

set -e

# Configuration (can be overridden via arguments)
OLLAMA_HOST="${OLLAMA_HOST:-{{OLLAMA_HOST}}}"
OLLAMA_PORT="${OLLAMA_PORT:-{{OLLAMA_PORT}}}"
DEFAULT_MODEL="${DEFAULT_MODEL:-{{DEFAULT_MODEL}}}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

# Output functions
status() { echo -e "${GRAY}[*] $1${NC}"; }
success() { echo -e "${GREEN}[+] $1${NC}"; }
error() { echo -e "${RED}[-] $1${NC}"; }
warning() { echo -e "${YELLOW}[!] $1${NC}"; }

# Parse arguments
MODEL="$DEFAULT_MODEL"
while [[ $# -gt 0 ]]; do
    case $1 in
        --model|-m)
            MODEL="$2"
            shift 2
            ;;
        --host|-h)
            OLLAMA_HOST="$2"
            shift 2
            ;;
        --port|-p)
            OLLAMA_PORT="$2"
            shift 2
            ;;
        --help)
            echo "Usage: $0 [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --model, -m <name>   Specify Ollama model (default: $DEFAULT_MODEL)"
            echo "  --host, -h <host>    Ollama host (default: $OLLAMA_HOST)"
            echo "  --port, -p <port>    Ollama port (default: $OLLAMA_PORT)"
            echo "  --help               Show this help message"
            echo ""
            echo "Examples:"
            echo "  $0                           # Use defaults"
            echo "  $0 --model deepseek-r1:8b    # Use specific model"
            echo "  $0 --host 192.168.1.100      # Use remote Ollama"
            exit 0
            ;;
        *)
            # Pass unknown args to claude
            break
            ;;
    esac
done

OLLAMA_URL="http://${OLLAMA_HOST}:${OLLAMA_PORT}"

# Banner
echo ""
echo -e "${CYAN}  Claude Code - Local Mode (Ollama)${NC}"
echo -e "${CYAN}  ===================================${NC}"
echo ""

# Step 1: Check Ollama is running
status "Checking Ollama at $OLLAMA_URL..."

if ! command -v curl &> /dev/null; then
    error "curl is required but not installed"
    exit 1
fi

VERSION_RESPONSE=$(curl -s --connect-timeout 5 "$OLLAMA_URL/api/version" 2>/dev/null || echo "")

if [[ -z "$VERSION_RESPONSE" ]]; then
    error "Cannot connect to Ollama at $OLLAMA_URL"
    echo ""
    echo -e "${YELLOW}  Make sure Ollama is running:${NC}"
    echo "    ollama serve"
    echo ""
    echo -e "${GRAY}  Or start the Ollama app if installed.${NC}"
    echo ""
    exit 1
fi

OLLAMA_VERSION=$(echo "$VERSION_RESPONSE" | grep -o '"version":"[^"]*"' | cut -d'"' -f4)
success "Ollama v$OLLAMA_VERSION is running"

# Step 2: Check models are available
status "Checking available models..."

TAGS_RESPONSE=$(curl -s --connect-timeout 5 "$OLLAMA_URL/api/tags" 2>/dev/null || echo "")

if [[ -z "$TAGS_RESPONSE" ]]; then
    error "Failed to list Ollama models"
    exit 1
fi

# Count models (simple grep-based count)
MODEL_COUNT=$(echo "$TAGS_RESPONSE" | grep -o '"name":"[^"]*"' | wc -l | tr -d ' ')

if [[ "$MODEL_COUNT" -eq 0 ]]; then
    warning "No models found in Ollama"
    echo ""
    echo -e "${YELLOW}  Pull a model first:${NC}"
    echo "    ollama pull qwen3-coder:30b"
    echo ""
    exit 1
fi

success "$MODEL_COUNT model(s) available"

# Step 3: Verify requested model exists
MODEL_EXISTS=$(echo "$TAGS_RESPONSE" | grep -o "\"name\":\"$MODEL\"" || echo "")

if [[ -z "$MODEL_EXISTS" ]]; then
    warning "Model '$MODEL' not found in Ollama"
    echo ""
    echo -e "${YELLOW}  Available models:${NC}"
    echo "$TAGS_RESPONSE" | grep -o '"name":"[^"]*"' | cut -d'"' -f4 | while read -r m; do
        echo "    - $m"
    done
    echo ""
    echo -e "${YELLOW}  Pull the model:${NC}"
    echo "    ollama pull $MODEL"
    echo ""
    exit 1
fi

success "Model '$MODEL' is available"

# Step 4: Configure environment for Claude Code
status "Configuring Claude Code environment..."

export ANTHROPIC_BASE_URL="$OLLAMA_URL"
export ANTHROPIC_API_KEY="ollama"

success "Environment configured"

# Step 5: Display summary
echo ""
echo -e "${CYAN}  Configuration:${NC}"
echo -e "${GRAY}    Backend:  $OLLAMA_URL${NC}"
echo -e "${GRAY}    Model:    $MODEL${NC}"
echo ""

# Step 6: Start Claude Code
status "Starting Claude Code..."
echo ""

# Pass through any remaining arguments
exec claude "$@"
